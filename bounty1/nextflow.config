nextflow.enable.dsl=2

params {
  samplesheet = 'resources/samplesheet.csv'
  controls_sheet = 'resources/chip_inputs.csv'
  cutrun_sheet = 'resources/sirt6_cutrun.csv'
  outdir = 'results'
  genome = 'hg19'
  genome_fasta = null
  bowtie2_index = null
  bismark_index = null
  mapq = 30
  peak_qvalue = 0.01
  cutrun_qvalue = 0.05
  min_cpg_depth = 6
  min_required_probe_fraction = 0.80
  sirt6_min_reciprocal_overlap = 0.50
}

process {
  executor = 'local'
  cpus = 2
  memory = '4 GB'
  time = '6h'

  // Keep a small number of simultaneous archive streams. HRA003336 plus
  // HRA005392 total roughly one TiB compressed, so unbounded download fan-out
  // is counterproductive and can overload both archive and local I/O.
  withLabel: stream_io {
    cpus = 4
    memory = '4 GB'
    time = '12h'
    maxForks = 2
  }

  withLabel: big_mem {
    cpus = 8
    memory = '32 GB'
    time = '24h'
  }
}

profiles {
  // GitHub-hosted runners expose four CPUs. This profile changes resources
  // only for graph/stub validation; production keeps the settings above.
  ci {
    process {
      cpus = 2
      memory = '4 GB'
      time = '1h'

      withLabel: stream_io {
        cpus = 2
        memory = '2 GB'
        time = '1h'
        maxForks = 1
      }

      withLabel: big_mem {
        cpus = 4
        memory = '8 GB'
        time = '1h'
      }
    }
  }
}
