nextflow.enable.dsl=2

params {
  samplesheet = 'resources/samplesheet.csv'
  controls_sheet = 'resources/chip_inputs.csv'
  cutrun_sheet = 'resources/sirt6_cutrun.csv'
  outdir = 'results'
  genome = 'hg19'
  reference_fasta_url = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.fa.gz'
  mapq = 30
  peak_qvalue = 0.01
  cutrun_qvalue = 0.05
  min_cpg_depth = 6
  min_required_probe_fraction = 0.80
  sirt6_min_reciprocal_overlap = 0.50
  pace_probe_flank = 500
}

process {
  executor = 'local'
  cpus = 2
  memory = '4 GB'
  time = '6h'

  // Archive streams are deliberately bounded. The production metadata points
  // to about one TiB of compressed input, so unlimited fan-out would only move
  // the bottleneck to remote archive/network I/O.
  withLabel: stream_io {
    cpus = 4
    memory = '6 GB'
    time = '18h'
    maxForks = 2
  }

  withLabel: big_mem {
    cpus = 8
    memory = '32 GB'
    time = '24h'
  }
}

profiles {
  // GitHub-hosted runners expose four CPUs. This profile is for stub/technical
  // validation only; production retains the resource settings above.
  ci {
    process {
      cpus = 2
      memory = '4 GB'
      time = '1h'

      withLabel: stream_io {
        cpus = 2
        memory = '2 GB'
        time = '1h'
        maxForks = 1
      }

      withLabel: big_mem {
        cpus = 4
        memory = '8 GB'
        time = '1h'
      }
    }
  }
}
