nextflow.enable.dsl=2

params {
  samplesheet = 'resources/samplesheet.csv'
  controls_sheet = 'resources/chip_inputs.csv'
  outdir = 'results'
  genome = 'hg19'
  genome_fasta = null
  bowtie2_index = null
  bismark_index = null
  mapq = 30
  peak_qvalue = 0.01
  min_cpg_depth = 6
  min_required_probe_fraction = 0.80
}

process {
  executor = 'local'
  cpus = 2
  memory = '4 GB'
  time = '6h'

  // Keep a small number of simultaneous archive streams. HRA003336 is almost
  // 1 TiB compressed, so unbounded download fan-out is counterproductive and
  // can overload both the archive endpoint and local network/disk pipelines.
  withLabel: stream_io {
    cpus = 4
    memory = '4 GB'
    time = '12h'
    maxForks = 2
  }

  withLabel: big_mem {
    cpus = 8
    memory = '32 GB'
    time = '24h'
  }
}
