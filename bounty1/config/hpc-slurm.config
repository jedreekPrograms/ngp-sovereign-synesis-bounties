// Optional production profile for an external SLURM cluster (WCSS/PCSS or similar).
// Use together with the repository's main nextflow.config:
//   nextflow -c bounty1/nextflow.config -c bounty1/config/hpc-slurm.config run bounty1/main.nf
//
// This file deliberately does not hard-code a site-specific queue/account.
// Supply those from the site environment or a private local config when required.

process {
    executor = 'slurm'
    errorStrategy = 'retry'
    maxRetries = 2

    cpus = 4
    memory = '8 GB'
    time = '24h'

    withLabel: stream_io {
        cpus = 8
        memory = '16 GB'
        time = '48h'
        maxForks = 4
    }

    withLabel: big_mem {
        cpus = 16
        memory = '64 GB'
        time = '48h'
    }
}

// Keep work on cluster-local/shared scratch chosen by the operator, e.g.
// NXF_WORK=/path/to/project/scratch/work.  Do not stage the whole ~1 TiB
// source archive into the Git repository or GitHub artifacts.
